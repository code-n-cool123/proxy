  "projects": [
   {
    "title": "BIManywhere and BIManywhere Pro",
    "description": "A standalone and cloud based (pro edition) building information model viewer for connecting the field with the office. Unique yet familiar model navigation and inspection. Nested object hierarchies and viewpoint folders. Viewpoint creation and sharing + markup/annotation. Highly configurable interface with many settings for navigation rate, acceleration and orientation. Object selection with property inspection and object to object or surface snap distance measurement. Drawing visitor utilizes multiple heuristics for drawing high object counts and every attempt is made to minimize memory usage and balance performance. Technology merged into Procore in 2019 and BIManywhere was sunset.",
    "dateRange": {},
    "associatedWith": "Oct 2011 - Sep 2018"
   },
   {
    "title": "Hardware accelerated word art for unix servers",
    "description": "A command line interface for generating high quality, decorated, deformed text, fast. Utilizes OpenGL, GLX, imageMagick and Cairo. Makes use of pBuffers and virtualGL for hardware access from a webserver. Supports outlined text, bezier curves, and arcs.",
    "dateRange": {},
    "associatedWith": "May 2012 - Sep 2012"
   }
