     {
      "title": "Sr. Software Engineer Financial Services Team",
      "timePeriod": {
       "startDate": {
        "month": 3,
        "year": 2020
       },
       "endDate": null
      },
      "totalDuration": "6 yrs 8 mos",
      "description": "Helped to prepare the company for IPO by moving towards updated Accounting standards and revamping all accounting reports.\nWorked around the clock with teammates in Europe and India timezones to meet a tight deadline for S-1 filing.\nImplemented SVP's vision of cost-of-goods-sold accounting for our inventory, covering many millions of inventory records over nearly a decade of company history.\nKey maintainer of company's internal credit system, spreading knowledge, monitoring status, and performing updates as needed.\nDeveloped system to generate invoices and payments related to special partnerships and used the system to simplify the Accounting reconciliation process.\nDeployed pipeline for securely generating 1099-K tax forms for qualifying customers and submitting to the IRS.",
      "insights": ""
     },
     {
      "title": "Software Engineer - Algorithms Team",
      "locationName": "San Francisco Bay Area",
      "timePeriod": {
       "startDate": {
        "month": 12,
        "year": 2018
       },
       "endDate": {
        "month": 3,
        "year": 2020
       }
      },
      "totalDuration": "1 yr 4 mos",
      "description": "Trained and deployed a photo-cropping algorithm in place of manual cropping done on images of skirts using a simple ML model trained to predict 2 coordinate points for cropping.\nIntegrated our system with a 3rd-party solution to retrieve AI-generated tags based on product images. The tags were used to enrich our search and filters for millions of products.",
      "insights": ""
     },
     {
      "title": "Software Engineering Manager - Special Projects",
      "timePeriod": {
       "startDate": {
        "month": 7,
        "year": 2017
