  "projects": [
   {
    "title": "Pascal Interpreter",
    "description": "Independent project written in C++ to interpret a subset of the Pascal programming language. Each piece was built from the ground up, including a lexical analyzer, a syntax analyzer, a semantic analyzer, and an interpreter. I constructed the recursive descent parser to build an abstract syntax tree. This project allowed for nested variable/procedure scopes, type checking, all basic calculation operations, and procedure calls.\n",
    "dateRange": {},
    "associatedWith": "Jul 2019 - Present"
   },
   {
    "title": "Network Analysis Tool \"Piggy\"",
    "description": "Piggy is a network debugging tool that I have used extensively since its creation. It acts as a man in the middle between network applications, so that the user can see all the data that is filtering through the connection. Piggy is written in C and uses the Sockets API. It has a host of functions, including but not limited to: logging, filtering data, handling raw input, creating an ncurses interface, and dropping and making connections on the fly.",
    "dateRange": {},
    "associatedWith": "Sep 2016 - Dec 2017"
   }
