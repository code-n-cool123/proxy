  "projects": [
   {
    "title": "Docusign Alt",
    "description": "An alternative to Docusign. A common React App, written in TypeScript, with minimal dependency on two widely used open-source PDF augmenting packages. Written with tedious detail for an entry level developer to fork and edit as they see fit. The two packages mentioned are \"pdf-lib\" and \"react-pdf\", which can be found in the NPM registry.\n\nA full-production version of the application, with custom UI, back-end support(with automated emailing) can be seen here:\n- https://mrwetjet.github.io/mrwetjet-docusign-alt/",
    "dateRange": {},
    "associatedWith": "Feb 2023 - May 2023"
   },
   {
    "title": "FinancialReact",
    "description": "A financial planner that reads/parses my Wells Fargo PDF statements ranging from 2014-2023.\n\n- Shows aggregations and individual amounts of money entering/exiting 1-to-many accounts\n- Aggregates the amounts of money transferred between accounts correctly\n- Allows regular expression look-up/filtering\n- Verbose/quiet debugging allowed in the UI for checking complication(s), if any, when the Flask back-end is parsing PDF's \n- Charting for nice visualizations of what money is spent for specified time periods\n\nMain issue/inconvenience is needing to manually upload the statement PDF. I'd rather not access my Wells Fargo account programmatically so I live with this issue. I also reached out about the secure API access but apparently it's only allowed for businesses.",
    "dateRange": {},
    "associatedWith": "Oct 2022 - Jan 2023"
   }
