  "projects": [
   {
    "title": "PunchEnder",
    "description": "PunchEnder is a single-page web app inspired by Kickstarter. PunchEnder allows users to create, follow, and back charitable projects, and earn rewards for participating.\n\n• Employed a responsive search feature for projects and categories using GraphQL server.\n\n• Created a multi-part form implementing features such as using multiple inputs or a datepicker to select a date, uploading and previewing images with AWS S3, and writing stories via a Draft.js based rich text editor.\n\n• Styled preview panels for rich text articles by using event listeners that expand the panel and move the blurred section on hover.\n",
    "dateRange": {},
    "associatedWith": "Nov 2019 - Nov 2019"
   },
   {
    "title": "Super",
    "description": "Super is a single-page web app inspired by Medium.\n\n• Combined the usage of the react-cropper library, Canvas API, and Amazon S3 web service to allow users to crop their profile & article images before resizing and storing the images.\n\n• Created a site design and is responsive to different screen and font sizes by using breakpoints and media queries with Sass along with viewport-relative units in CSS.\n\n• Used Mongoose virtual populate feature to facilitate an idiomatic setup of Mongoose models and their relations for fetching data across collections.\n",
    "dateRange": {},
    "associatedWith": "Nov 2019 - Nov 2019"
   }
