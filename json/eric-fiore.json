  "projects": [
   {
    "title": "WWC",
    "description": "This project will allow a local animal refuge to schedule work times and allow volunteers to request time off.  The two components of the project are: a) a web portal that will allow management to view and change work times b) a mobile app that will be used by volunteers to schedule times off.  The mobile app will work by having volunteers choosing a desired day off, then a message will be sent to all possible people that could cover the shift.  When a recipient of the message agrees to cover the calendar will be automatically updated and management will be notified.\nTechnologies used:\nLanguage: Java\nFramework: Spring Boot\nDatabase: SQL",
    "dateRange": {},
    "associatedWith": "Nov 2020 - Present"
   },
   {
    "title": "SSL",
    "description": "The purpose of this project is to allow easy access to documentation for Sharp personal.  The software gives users the power to create documentation which is stored in a SQL database, then indexed to an ElasticSearch index.  Search of the index is pervasive throughout the site giving users fast access to data.  User comments can also be made to any piece of documentation.\nTechnologies used:\nLanguage: Python\nFramework: Django\nDatabase: SQL\nother: ElasticSearch",
    "dateRange": {},
    "associatedWith": "May 2020 - Jun 2020"
   }
