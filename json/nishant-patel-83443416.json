  "projects": [
   {
    "title": "Map reduce jobs to calculate page rank of a web graph",
    "description": "The project dealed with finding page rank of a web graph(to close approximation of 0.001) using map reduce over hadoop. We tried using simple map reduce , blocked map reduce approach ,map reduce using random partitioning of graph and finally map reduce using Gauss-seidel approach. We used Java to code and Amazon ec2 instances to setup deployment environment. The project was a great learning curve and exposed to Map reduce , Hadoop and Amazon cloud environment.",
    "dateRange": {},
    "associatedWith": "Mar 2013 - Present"
   },
   {
    "title": "Scaling and Optimizing MAPS in Hadoop on Amazon ec2",
    "description": "The project is mentored by Professor Robbert van Renesse and focuses on scaling existing monolithic MAPS (Software used by GE to predict energy production) to optimize it for minimal cost and higher efficiency. We plan to use Map Reduce jobs on Hadoop framework deployed across various clusters on Amazon EC2.",
    "dateRange": {},
    "associatedWith": "Jan 2013 - Present"
