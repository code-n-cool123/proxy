   {
    "title": "Baxter.com",
    "description": "A RESTful, single-page service-booking app inspired by Rover\n- Implements a Ruby on Rails framework on a PostgreSQL database that interacts with Redux and React to allow for predictable DOM rendering\n- Utilizes reusable, DRY React components, improving code maintainability and scalability\n- Employs AWS S3 and the gems Paperclip and Figaro to allow users to upload images to the cloud securely\n- Integrates Google Maps APIs to allow users to search based on the current bounds of the map and optional filters (i.e. rates, availability)",
    "dateRange": {},
    "associatedWith": "Jan 2018 - Present"
   },
   {
    "title": "Words with Myself",
    "description": "A single-page word game inspired by Scramble with Friends developed using JavaScript, jQuery, HTML, and CSS \n- Achieves an Object Oriented Programming design by separating all elements of the DOM into their own classes, which allowed for easier testing and refactoring\n- Leverages event handlers on certain mouse events to manipulate the app’s state and DOM\n- Incorporates Google’s Firebase Realtime Database to update and render a universal leaderboard in realtime",
    "dateRange": {},
    "associatedWith": "Jan 2018 - Present"
