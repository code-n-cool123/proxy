  "projects": [
   {
    "title": "Trade Confirms Modernization ",
    "description": "As a member of the Customer Communications tribe, I participated with the modernization effort to move Fidelity’s trade confirms application from the mainframe to the cloud.  This effort was the beginning of moving the confirms domain into a cloud based environment to reduce the use of batch jobs and mainframe servers.  Our squad created a skeleton structure of the domain using cloud based architecture through AWS.  As a result, this updated the technology stack of the domain as we moved bits of the trade confirms logic into the AWS environment.  ",
    "dateRange": {},
    "associatedWith": "Jan 2019 - Mar 2021"
   },
   {
    "title": "FIDO U2F Authentication",
    "description": "In this project, the LEAP team was given a task to put together a proof-of-concept (PoC) application to apply FIDO standards and U2F protocols.  The application utilized Yubico crypto-keys to authenticate and verify users as a second factor.  The development included a front end user experience in Angular using NodeJS, API Development on LWC Framework, Integrate with Daon IdentityX server, full test automation with JUnit and JMeter, and Agile methodology with CI/CD.",
    "dateRange": {},
    "associatedWith": "Jul 2018 - Oct 2018"
   }
