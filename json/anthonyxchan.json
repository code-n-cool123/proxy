  "projects": [
   {
    "title": "Blog with Django Framework",
    "description": "A blog project utilizing Django framework. \n\n•\tDeveloped the entire project according to Django’s Model, Template and Views architecture.\n•\tCreated UI using JavaScript, HTML5, CSS, Bootstrap and third-party modules like CrispyForms and TinyMCE.\n•\tDesigned two models for saving user profile information and posts details. \n•\tWorked on different forms and model-forms which allows user to manage and update their post and user profile. Registered user can publish, update, delete their posts as well as updating their profile information when they are logged in. \n•\tUsed template tags and multiple filters to manage the information to be displayed in the template.\n•\tMade use of different class-based views such as CreateView, DeleteView, PasswordResetView, LoginView and some custom function-based view to return required content.\n•\tManaged code versioning with GitHub, Git and deploy the project to pythonanywhere.com.\n•\tUtilized: Python, Django, HTML, CSS, JavaScript, TinyMCE, Pillow, CrispyForms, Bootstrap, SQLite\n",
    "dateRange": {},
    "associatedWith": "May 2019 - Present"
   },
   {
    "title": "Database Design and Implementation for E-commerce Site",
    "description": "Developed a database management system for an E-commerce website to store, manipulate, and search for product information using SQL. Created structural database rules, conceptual ERD and Physical ERD diagram to assist database construction. Normalized the database to reduce data redundancy and created index in table for better data retrieval. Built multiple procedures, triggers and queries according to database design and use case for better data management.\n\nUtilized: MS SQL server\n",
    "dateRange": {},
    "associatedWith": "Feb 2019 - May 2019"
   }
