  "projects": [
   {
    "title": "Hopchat - chat system developed in Java",
    "description": "Object-Oriented Software Engineering, 600.321. The goal was to design and construct a communications systems for individual classes at Hopkins -- it is often difficult to make new friends and study partners in new classes, and there's no source of help or discussion unless you go directly to the TAs and professors. HopChat sought to provide one more resource for students, their peers, by providing individual chatrooms with a comment saving and voting system, so that everyone could be a judge of what the most helpful comments and links are for future reference.\n\nUse case driven design, developed in Java, version control with Subversion (SVN) in a team of 4 programmers, and a personally managed the MySQL Database server for the project.",
    "dateRange": {},
    "associatedWith": "Sep 2012 - Dec 2012"
   },
   {
    "title": "Red Skies - Top-down Shoot-em-up video game using Pygame",
    "description": "Introduction to Video Game Design, 600.255. Worked in a team of four (two programmers, two artists) to develop a video game over the course of a semester. Developed in Python using the Pygame library (http://www.pygame.org/). Source code management/Revision control in Subversion (SVN). Assisted in constructing the primary game engine, designed and created a \"cutscene system\" supporting scrolling text, customized timings and animations. \n",
    "dateRange": {},
    "associatedWith": "Sep 2011 - Dec 2011"
   }
