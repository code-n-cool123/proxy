  "projects": [
   {
    "title": "Deep Reinforcement Learning for Cartpole Control",
    "description": "This project explores various deep reinforcement learning methods applied to the classic control problem of CartPole. The study compares different variants of Deep Q-Learning (DQN), including DQN, Double DQN, Dueling DQN, and CNN-based DQN, as well as Proximal Policy Optimization (PPO)\n\n• Implemented DQN with 200 steps and a 99% success rate in 500 episodes in Cartpole simulation, improved control stability. \n• Optimized DQN hyperparameters, resulting in 18% faster simulation runtime and superior outcomes.\n• Streamlined team collaboration and knowledge sharing through the implementation of Double DQN, Dueling DDQN, and CNN-based DQN.",
    "dateRange": {},
    "associatedWith": "Aug 2023 - Dec 2023"
   },
   {
    "title": "NBA Winner Predictor",
    "description": "The project aims to build a predictive model for NBA game winners using machine learning, specifically exploring the applications of feed-forward neural networks, random forests, and logistic regression. The dataset spans NBA games from the 2007-2008 to the 2021-2022 seasons, including both regular season and playoff matchups\n\n• Achieved 66% accuracy in predicting NBA winners with FNN, RF, and LR models using Python. \n• Increased model performance and accuracy for FNN, RF and LR models by 12% through model evaluation using Scikit-learn and Matplotlib.\n• Identified and mitigated over-fitting in the Neural Network model by implementing L2 regularization, resulting in an accuracy improvement from 62% to 66%.\n• Reduced computational time by 15% through PCA analysis of the 2007-2022 NBA dataset, optimizing data dimensionality.",
    "dateRange": {},
    "associatedWith": "Jan 2023 - May 2023"
   }
