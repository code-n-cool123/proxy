  "projects": [
   {
    "title": "The Scion Group",
    "description": "For my friends at Scion, I helped rebrand their WordPress website using frontend and backend skills to implement all aspects of the project after the Figma handoff. I created the front end with SCSS and included tasteful GSAP animations on each page to soften the user experience.\n\nOne of my favorite features of this site is the map on the Communities page. The map is a custom Mapbox integration that displays pins sources from data in cached json files.",
    "dateRange": {},
    "associatedWith": ""
   },
   {
    "title": "The Suquamish Museum",
    "description": "The Suquamish Museum app is a CMS driven iOS and Android app that allows museum visitors to dig deep into their surrounding as they walk through the Suquamish Museum.\n\nSince the app is 100% functional offline we had to find a solution to deliver the user map which functions very much like modern mapping services such as Google Map or Apple Maps. This was done with open source mapping technology, offline map tile sets, and a lot of hard work!\n\nThe CMS allows the client to selectively publish new content and provides a web view to preview the app in a web browser with drafted content before publishing.",
    "dateRange": {},
    "associatedWith": ""
