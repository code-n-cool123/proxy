  "projects": [
   {
    "title": "Anabatos",
    "description": "A full-stack Android application that features a homepage; chat, contacts, and weather pages; and login with external verification and password recovery. Scrum development techniques were followed. Scrum meetings were held daily, and backlog grooming and retrospectives were held every sprint.\n\nI personally worked on the frontend and backend of the app's chat feature, and designed the logo of the app. The frontend was made with Java and XML on Android Studio. The backend was made with Node.js and its Express framework along with a few SQL queries for the PostgreSQL database. The backend was deployed on Heroku. All endpoints were tested using Postman.",
    "dateRange": {},
    "associatedWith": "Apr 2021 - Jun 2021"
   },
   {
    "title": "Realm Defense Force",
    "description": "A web-based game tower-defense game built with Javascript, HTML, and some CSS.\n\nI personally worked on animating the entities of the game, implementing collision detection between towers and enemies, and designing the maps and difficulty of each level.",
    "dateRange": {},
    "associatedWith": "Jan 2021 - Mar 2021"
