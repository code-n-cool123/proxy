  "projects": [
   {
    "title": "Test Result Aggregation for Releases",
    "description": "I added a new feature to our historical test results web application which collects and displays all of our automated test results for a release build, with support for annotating individual tests. Test results are uploaded automatically after a Jenkins job completes. In addition, logs for any failed tests, associated JIRA issues, and the associated Jenkins jobs are all linked in one place. Previously, this information was tediously and manually collected in a Google Sites page based on emailed test results.",
    "dateRange": {},
    "associatedWith": "Jan 2017 - Present"
   },
   {
    "title": "Parallel Test Executor",
    "description": "Created a framework for parallelizing tests for PingDirectory. These include unit tests (Ant + TestNG), functional integration tests (Maven + TestNG), and mixed version and update tests (custom Java tool that wraps Maven and TestNG). Test suites are broken up into individual test units, which are uploaded to the server component. The server launches clients through Jenkins (on demands nodes via AWS) which connects to the server, retrieves a test unit, and executes it. Support for each type of test is provided by a plugin, allowing for ease of extension in the future. The framework is also resilient to failures/downtime of any component (Jenkins master, Jenkins slave/test client, test server).",
    "dateRange": {},
    "associatedWith": "Jul 2018 - Jun 2019"
   }
  ],
