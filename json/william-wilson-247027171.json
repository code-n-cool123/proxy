  "projects": [
   {
    "title": "Junior Design: Smart Cooling",
    "description": "Designing a cooling system, which uses multiple fans and varying speeds to achieve the optimal cooling of a system using multiple temperature sensors. The system adjusts which fans are turned on or off at any time, as well as the speed of the fans to maintain a specific operating temperature for the device being cooled. The fans are also controlled to focus cooling on the warmest part of the system, determined by the temperature sensors. This ensures that each part of the system is getting just the amount of cooling that it needs so that power consumption is optimized.",
    "dateRange": {},
    "associatedWith": "Jan 2019 - Present"
   },
   {
    "title": "Magnetic Levitation",
    "description": "A mounted electromagnet was connected to a battery through a MOSFET, which was switched by an Arduino’s pulse-width modulation. A magnetic object was levitated beneath the electromagnet. A Hall effect sensor connected to the electromagnet provided feedback to the Arduino, which would adjust the PWM signal to maintain a specific levitation height for the magnetic object.",
    "dateRange": {},
    "associatedWith": "Nov 2018 - Present"
   }
